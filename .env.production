# Production Adaptive Engine activation (Part 7, Stage A)
#
# Controlled via config/env — never hardcoded ON in code. Flip to "false" or
# remove this line to roll back without a code change.
#
# Stage A: Adaptive Engine runtime ON for production builds. The live app
# produces decisions + decision traces only; it never auto-executes (execution
# is the explicit `execute()` step, gated by uiExecution).
#
# Stages B (reflection) and C (uiExecution) are NOT activated yet. Their
# knobs are documented in .env.example.
VITE_NEUROBRIDGE_ADAPTIVE_RUNTIME=true
