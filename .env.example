VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# NOTE (pre-existing, not introduced by the agent work): this key is bundled into the
# browser build and used directly from several frontend files (dyslexia/ASD AI features).
# That's a real key-exposure risk worth fixing separately — see the agent feature's
# final report — but out of scope here. Never add new frontend-facing Gemini calls.
VITE_GEMINI_API_KEY=[GCP_API_KEY]

# --- Backend (FastAPI) — plain env vars, no VITE_ prefix, never bundled into the frontend ---
# Same Supabase project as above; backend/auth.py uses these (anon key only, not a secret)
# to validate the frontend's Supabase session token on every request.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
# Server-side Gemini key for the agent orchestrator (backend/services/agent_service.py).
# Required for the agent to do anything beyond deterministic navigation/safety replies.
GEMINI_API_KEY=[GCP_API_KEY]
# Optional: Postgres/Supabase connection string. Falls back to a local SQLite file if unset.
# DATABASE_URL=postgresql://...
# Comma-separated list of allowed frontend origins for CORS. Set this explicitly in production
# (e.g. your Vercel domain) — the code no longer allows "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Which Gemini model the orchestrator uses.
# GEMINI_MODEL_NAME=gemini-3.6-flash

# --- Agent execution tuning (all optional; sane defaults if unset) ---
# Max Gemini <-> tool round trips per message before the agent gives up and
# returns a structured FAILED state instead of looping forever.
# AGENT_MAX_STEPS=4
# Per-LLM-call timeout, and the one-retry policy only applies to transient
# errors (timeout/network/upstream) within this budget.
# AGENT_LLM_TIMEOUT_MS=15000
# Per-tool-call timeout (a thread-pool safety net — real tools are simple sync
# DB calls today, this exists for when a slower one is added later).
# AGENT_TOOL_TIMEOUT_MS=5000
# How long the short-TTL user-preferences cache (get_user_learnings) stays warm.
# AGENT_CACHE_TTL_SECONDS=20
# Messages/hour for real (non-demo) authenticated accounts — demo mode has its
# own fixed, lower limit (20/hr) since it has no real credential behind it.
# AGENT_REAL_RATE_LIMIT_PER_HOUR=60
# Per-user/hour limit on the OCD endpoints that each trigger a direct Gemini call
# outside the agent chat loop (create hierarchy / ERP session / journal entry) —
# without this a user could bypass AGENT_REAL_RATE_LIMIT_PER_HOUR entirely.
# OCD_AI_RATE_LIMIT_PER_HOUR=40

# --- Adaptive Engine feature flags (default OFF) ---
# See backend/adaptive/engine/featureFlags.js for the staged activation plan.
# Stage A (runtime): live decision path in the app (decides only; no
# auto-execution). Activated in production via .env.production.
# VITE_NEUROBRIDGE_ADAPTIVE_RUNTIME=false
# Stage B (reflection): learned signals feeding Tier 9. Not yet activated.
# VITE_NEUROBRIDGE_ADAPTIVE_REFLECTION=false
# Stage C (uiExecution): UI executor applying actions to live rendering.
# Not yet activated — the executor integration review is still pending.
# VITE_NEUROBRIDGE_ADAPTIVE_UI_EXECUTION=false
